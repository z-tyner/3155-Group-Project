# backend/.env.example
# Description: Backend environment variables template defining PORT, DATABASE_URL, JWT_SECRET, and AWS S3/Cloudflare R2 storage credentials.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/rat-game
# Separate database for tests (they wipe all data). Name must contain "test".
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rat_game_test
# Groq API key for The Grand Mutator (AI card generation). Get one at console.groq.com
# Put the real key in backend/.env.local (git-ignored), NOT in .env, since .env is committed.
GROQ_API_KEY=
# Optional: override the Groq model (default openai/gpt-oss-120b)
# GROQ_MODEL=
# Optional: per-player AI card limits (defaults 3 per minute, 20 per day)
# AI_LIMIT_PER_MINUTE=
# AI_LIMIT_PER_DAY=
